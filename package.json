{
  "name": "beep-beep-bus",
  "private": true,
  "version": "0.1.0",
  "description": "Beep-Beep Bus — a kids' game: build your own bus at the factory, then drive it along a route, stopping at bus stops and red lights.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/rubik": "5.2.8",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.4"
  }
}
